# ─────────────────────────────────────────────
# Stash — environment variable reference
# Copy to .env and fill in values for your environment.
# Variables marked [required] must be set for that feature to work.
# `./start.sh` and docker-compose load this file automatically.
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=3456

# ── Database ─────────────────────────────────
# Used by docker-compose.prod.yml. Choose strong credentials.
POSTGRES_USER=stash
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stash

# Full connection string used by direct backend runs (`./start.sh`).
# Docker Compose sets its own in-network DATABASE_URL for containers.
DATABASE_URL=postgresql://stash:stash@localhost:5432/stash

# Connection pool sizing. Increase DB_POOL_MAX for high-traffic deployments.
DB_POOL_MIN=2
DB_POOL_MAX=20

# Celery broker + cache. Compose sets its own in-network REDIS_URL.
REDIS_URL=redis://localhost:6379/0

# ── Local persistence (docker-compose.local.yml) ──
# Host directory holding self-hosted state: postgres/, redis/, and secrets/
# (the auto-generated integrations keyring). Relative paths resolve against
# the compose project directory; point it elsewhere (e.g. another disk) freely.
# STASH_DATA_DIR=./data

# ── URLs & CORS ───────────────────────────────
# PUBLIC_URL is the frontend origin (used for invite links, OAuth redirect
# URIs, and CORS defaults).
# ⚠ PRODUCTION: set to your actual domain, e.g. https://app.yourcompany.com
PUBLIC_URL=http://localhost:3457
CORS_ORIGINS=http://localhost:3457,http://localhost:3456

# ── Admin Analytics ──────────────────────────
# Optional. Leave ADMIN_PASSWORD unset to disable backend admin endpoints.
# When set, both values must be at least 32 characters. The www/ landing
# page's admin pages use the same two variables (see www/ section below).
# ADMIN_PASSWORD=
# ADMIN_COOKIE_SECRET=

# ── Security audit ───────────────────────────
# HMAC key for redacted identifiers (emails, client IPs) in security audit
# events. Required when AUTH0_ENABLED=true; local dev uses a built-in dev key.
# AUDIT_HASH_KEY=

# ── Managed Auth0 ────────────────────────────
# Optional for self-hosting. Required for the managed product.
# AUTH0_ENABLED=true
# NEXT_PUBLIC_AUTH0_ENABLED=true
# AUTH0_DOMAIN=tenant.example.com
# AUTH0_AUDIENCE=https://api.yourcompany.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_SECRET=
# Frontend-side (frontend/managed/): must be an HTTPS origin without a path
# when managed Auth0 is enabled.
# APP_BASE_URL=https://app.yourcompany.com

# ── Frontend build-time (frontend/Dockerfile) ──
# Usually not needed in .env: docker-compose injects BACKEND_INTERNAL_URL
# (http://backend:3456) itself. NEXT_PUBLIC_API_URL is only for managed
# deploys with a separate API host. next.config.ts rewrites read these at
# build time, so changes require a rebuild.
# BACKEND_INTERNAL_URL=http://backend:3456
# NEXT_PUBLIC_API_URL=https://api.yourcompany.com
# NEXT_PUBLIC_APP_URL=            # fallback alias for PUBLIC_URL in the client bundle
# NEXT_PUBLIC_FORCE_ONBOARDING=   # dev helper: force the onboarding flow after login

# ── Embeddings ──────────────────────────────────────────────────
# Provider: openai | huggingface | local | none | auto (default).
# "auto" detects from available keys: OPENAI_API_KEY → openai, HF_TOKEN → huggingface, else → local.
# With no keys set, Stash uses local sentence-transformers — no API key required.
# EMBEDDING_PROVIDER=auto

# Option 1: OpenAI (or any OpenAI-compatible API — Gemini, Cohere, Nomic, etc.)
# OPENAI_API_KEY=sk-proj-...
# EMBEDDING_API_KEY=sk-...                  # optional override for embedding-only key
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Option 2: Hugging Face Inference API (any HF Hub model)
# HF_TOKEN=hf_...
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5          # default

# Option 3: Local sentence-transformers (free, no API key, downloads model on first use)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2          # default

# Option 4: Off — semantic search returns 503, everything else works
# EMBEDDING_PROVIDER=none

# Shared
# EMBEDDING_DIMS=384                        # vector dimensions (must match your DB schema)

# Tuning (defaults shown)
# EMBEDDING_CONCURRENCY=8
# EMBEDDING_MAX_ATTEMPTS=3
# EMBEDDING_RETRY_BASE_DELAY=0.5            # seconds
# EMBEDDING_RETRY_MAX_DELAY=10.0            # seconds

# ── File Storage (S3-compatible) ─────────────
# Stash supports any S3-compatible object store (AWS S3, Cloudflare R2, MinIO).
# Leave blank to disable file uploads.
# Required when managed Auth0 is enabled. S3_ENDPOINT must be an HTTPS origin.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=stash
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_REGION=auto
# Optional separate public bucket for world-readable downloads (public URLs
# are served straight from this bucket + base URL; unset disables public links).
# S3_PUBLIC_BUCKET=
# S3_PUBLIC_BASE_URL=

# ── Integrations (OAuth token encryption) ────
# Fernet key used to encrypt OAuth tokens stored for GitHub/Google Drive/Notion
# integrations. Required when managed Auth0 is enabled. `./start.sh` and Docker
# Compose generate a durable key automatically when this is unset. If you manage
# secrets outside Compose, set a comma-separated keyring: the first key encrypts
# new tokens, and later keys decrypt tokens written before rotation.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# INTEGRATIONS_ENCRYPTION_KEY=
# INTEGRATIONS_ENCRYPTION_KEY_FILE=/app/.secrets/integrations_encryption_key   # container entrypoint only

# ── Integration providers (per-user OAuth) ───
# Every provider uses the same shape: client id/secret from the provider's
# developer console, plus the backend callback URL registered there. Defaults
# are localhost examples; register HTTPS callbacks for real deployments.

# Linear — Linear → Settings → API → OAuth Applications; enable webhooks
# pointed at /api/v1/integrations/linear/events with the signing secret below.
# LINEAR_OAUTH_CLIENT_ID=
# LINEAR_OAUTH_CLIENT_SECRET=
# LINEAR_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/linear/callback
# LINEAR_WEBHOOK_SECRET=
# LINEAR_API_URL=https://api.linear.app/graphql

# Google Drive — Google Cloud Console OAuth client.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/google/callback
# Drive file picker: browser API key + GCP project number (NOT the OAuth
# client id). Both from the Google Cloud Console project dashboard.
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PICKER_APP_ID=

# Gmail — read-only Gmail API scope. Use an OAuth client from a separate
# Google Cloud project from Drive if disconnect/revocation must be independent.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/gmail/callback

# GitHub — GitHub → Settings → Developer settings → OAuth Apps.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/github/callback
# Optional server-side token for skill-import rate limits.
# GITHUB_TOKEN=

# Notion — https://www.notion.so/my-integrations (public integration).
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/notion/callback

# Jira (Atlassian 3LO OAuth 2.0) — create an OAuth 2.0 (3LO) app at
# https://developer.atlassian.com/console with scopes read:jira-work,
# read:jira-user, offline_access.
# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# JIRA_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/jira/callback

# Asana — https://app.asana.com/0/my-apps with granular read scopes
# projects:read, tasks:read, users:read, workspaces:read.
# ASANA_OAUTH_CLIENT_ID=
# ASANA_OAUTH_CLIENT_SECRET=
# ASANA_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/asana/callback

# Gong — Gong admin → API → OAuth 2.0 app.
# GONG_OAUTH_CLIENT_ID=
# GONG_OAUTH_CLIENT_SECRET=
# GONG_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/gong/callback

# Slack — Slack app with OAuth + Events API. SLACK_SIGNING_SECRET verifies
# inbound webhook signatures (X-Slack-Signature).
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/slack/callback
# SLACK_SIGNING_SECRET=

# X/Twitter — OAuth app for reading bookmarks/likes, plus enrichment APIs.
# TWITTER_OAUTH_CLIENT_ID=
# TWITTER_OAUTH_CLIENT_SECRET=
# TWITTER_OAUTH_REDIRECT_URI=http://localhost:3456/api/v1/integrations/twitter/callback
# TWITTERAPI_IO_KEY=          # twitterapi.io enrichment
# SCRAPECREATORS_API_KEY=     # scrapecreators.ai enrichment

# Granola connects through its MCP server over OAuth 2.0 (Dynamic Client
# Registration + PKCE) — no client id/secret to manage. Set the publicly
# reachable backend callback URL Granola redirects to after sign-in. The MCP
# endpoint defaults to the public server and rarely needs overriding.
# Managed Auth0 deployments require configured OAuth redirect URIs to be HTTPS
# callback URLs without path params, query strings, or fragments. Localhost
# examples are local development only.
# GRANOLA_OAUTH_REDIRECT_URI=https://your-backend/api/v1/integrations/granola/callback
# GRANOLA_MCP_URL=https://mcp.granola.ai/mcp

# ── Email (Postmark) ─────────────────────────
# Transactional email (invites, digests). Unset disables sending.
# POSTMARK_SERVER_TOKEN=
# Where enterprise-intent signups are sent as sales leads.
# SALES_NOTIFY_EMAIL=henry@ferganalabs.com

# ── Ops alerts ───────────────────────────────
# Critical errors are posted to this Slack channel; the installed bot must be
# a member. Missing config or failed delivery raises — logs are not delivery.
# ALERT_SLACK_TEAM_ID=
# ALERT_SLACK_CHANNEL_ID=

# ── Telegram bot (talk-to-Stash over Telegram) ──
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=    # echoed as X-Telegram-Bot-Api-Secret-Token

# ── Billing (Stripe) ─────────────────────────
# Leave STRIPE_SECRET_KEY unset to disable billing entirely (self-host
# default): billing endpoints 404 and the source pay gate is not enforced.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTHLY_PRICE_ID=price_...   # recurring Pro $20/month
# STRIPE_ANNUAL_PRICE_ID=price_...    # recurring Pro $200/year
# Internal team domains get Pro for free; set to false to test the paywall.
# INTERNAL_DOMAINS_FREE_PRO=true
# Free accounts get this many scheduled curator runs per calendar month.
# FREE_CURATOR_RUNS_PER_MONTH=10

# ── Ask-the-Stash (optional LLM features) ─────
# When set, enables the chat-style "ask-the-stash" answer endpoint and automatic
# session summarization. Without it those features quietly stay disabled — the
# core product (sessions, pages, files, skills, search) works fine without an
# LLM key.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6        # quality tier (default)
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5    # fast tier (default)

# Gemini for PDF vision transcription (backend/services/pdf_ocr.py).
# GEMINI_API_KEY=...
# GEMINI_EXTRACTION_MODEL=gemini-3-flash-preview

# Managed model keys (server-owned, cloud agent on paid tiers). OpenRouter is
# the one-key-many-models option.
# OPENROUTER_API_KEY=
# MANAGED_GEMINI_API_KEY=

# ── Cloud agent (per-user sprite VM) ─────────
# "sprites" runs each user's agent on their Fly Sprite; "local" execs on this
# machine's own agent install (dev mode — no Sprites credentials).
# AGENT_EXEC_MODE=local
# SPRITES_TOKEN=                 # [required] when AGENT_EXEC_MODE=sprites
# SPRITES_API_URL=https://api.sprites.dev
# SPRITES_STASH_API_URL=         # [required] when sprites; must be reachable from Fly
# AGENT_TURN_TIMEOUT_SECONDS=600

# ── Worker tuning ────────────────────────────
# Memory cap for file-extraction worker subprocesses.
# EXTRACTION_MEMORY_LIMIT_MB=1024

# ── PPTX export (required for /api/v1/pages/{id}/export?format=pptx) ─────
# The HTML→PPTX exporter calls the aspose-pptx service in powerpoint-mcp/
# (deployed to Render). Set the public URL + matching bearer token here.
# Without these, the pptx and gslides exporters will fail with a runtime
# error pointing at this missing config.
# ASPOSE_PPTX_URL=https://stash-o5mq.onrender.com
# ASPOSE_PPTX_TOKEN=...
# Service-side (set on the aspose Render service, not here):
#   ASPOSE_LICENSE_DATA (base64 license), MAX_SESSIONS=3, SESSION_TIMEOUT_MINUTES=60

# ── Reward models (required to run training / GEPA jobs) ─────
# Dedicated Celery reward queue; see rm_worker/README.md.
# RM_COMPUTE is required by the API; clients do not choose the runtime.
# S3 settings above are required by both the API and worker, even for local jobs.
# ANTHROPIC_API_KEY is required for feedback extraction and default GEPA models.
# RM_COMPUTE=local                      # local or modal
# RM_WORKER_PYTHON=/path/to/stash/rm_worker/.venv/bin/python
# RM_ARTIFACT_DIR=/path/to/rm-artifacts  # temporary job directories
# MODAL_TOKEN_ID=...                    # required for hosted Modal execution
# MODAL_TOKEN_SECRET=...

# Agent Workbench action grading (no local model training).
# TYPESAFE_API_KEY=             # server-only JEV credential
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_SECONDS=45
# ANTHROPIC_API_KEY above is also required for correction extraction/draft proposals.

# ── Automatic annotation: step labels and scores ────
# Labels each step of a trace and scores it by fixed rules; see
# docs/reward-models/DESIGN.md. Trace content is sent to OpenAI, so
# OPENAI_API_KEY must be set; TYPESAFE_API_KEY adds the optional quality checks.
# STEP_LABEL_MODEL=gpt-6-sol
# STEP_LABELING_MAX_CHUNKS=80
# STEP_LABELING_MAX_CHARS=200000

# ─────────────────────────────────────────────
# Below: env read by OTHER parts of the repo — not loaded from this .env.
# ─────────────────────────────────────────────

# ── Landing page (www/, deployed separately) ──
# POSTMARK_SERVER_TOKEN=       # contact-sales form
# TURNSTILE_SECRET_KEY=        # Cloudflare Turnstile verification
# TURNSTILE_HOSTNAME=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# ADMIN_PASSWORD=              # www admin pages' backend token
# ADMIN_COOKIE_SECRET=         # www admin session cookies
# MANAGED_APP_URL=https://app.joinstash.ai
# NEXT_PUBLIC_API_URL=         # www admin server actions → backend API

# ── stash CLI (user shell env) ───────────────
# STASH_URL=https://your-stash-backend
# STASH_API_KEY=               # from Settings → API keys
# STASH_SCOPE=                 # data scope for the CLI
# STASH_TELEMETRY=             # opt out with STASH_TELEMETRY=0

# ── Local dev only (start.sh / tests) ────────
# START_KILL_DEV_SERVER=1      # auto-kill a process holding port 3457
# TEST_DATABASE_URL=           # pytest suite (backend/tests/)
